# ===== Salesforce 接続（未設定ならデモデータで起動します） =====
# My Domain の URL（例: https://yourcompany.my.salesforce.com）
SF_LOGIN_URL=
# 外部クライアントアプリ（または接続アプリ）のコンシューマー鍵／秘密
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=62.0

# ===== 実績の集計ルール =====
# 商談商品(OpportunityLineItem)の原価項目
SF_COST_FIELD=FinalCost__c
# 利用日として使う項目（商談商品の作成日 = CreatedDate）
SF_USAGE_DATE_FIELD=CreatedDate
SF_USAGE_DATE_IS_DATETIME=true
# このステージ以降（並び順）の商談を実績として集計。失注は除外
SF_MIN_STAGE=請求

# ===== その他 =====
PORT=3000
# 会計年度の開始月（未設定なら Salesforce の組織設定から取得）
# FISCAL_YEAR_START_MONTH=4
YEARS_TO_SHOW=5
TZ_OFFSET=+09:00
# 口コミ保存先（SQLite）
# REVIEW_DB_PATH=./data/reviews.db
