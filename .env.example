# ===== Salesforce ログイン（SF_CLIENT_ID が未設定ならデモデータ・ログインなしで起動） =====
# ログイン先（本番: https://login.salesforce.com / Sandbox: https://test.salesforce.com / My Domain URL も可）
SF_LOGIN_URL=https://login.salesforce.com
# 外部クライアントアプリ（接続アプリ）のコンシューマー鍵
SF_CLIENT_ID=
# コンシューマーの秘密（アプリで「Web サーバーフローの秘密が必要」をオフにした場合は空でOK。PKCE を使用）
SF_CLIENT_SECRET=
SF_API_VERSION=62.0

# このアプリの URL（コールバック URL は ${APP_BASE_URL}/oauth/callback）
APP_BASE_URL=http://localhost:3000
# SF_REDIRECT_URI=http://localhost:3000/oauth/callback

# ===== 実績の集計ルール =====
# 商談商品(OpportunityLineItem)の原価項目
SF_COST_FIELD=FinalCost__c
# 利用日として使う項目（商談商品の作成日 = CreatedDate）
SF_USAGE_DATE_FIELD=CreatedDate
SF_USAGE_DATE_IS_DATETIME=true
# このステージ以降（並び順）の商談を実績として集計。失注は除外
SF_MIN_STAGE=請求

# ===== その他 =====
PORT=3000
# 会計年度の開始月（1 = 1月〜12月）
FISCAL_YEAR_START_MONTH=1
YEARS_TO_SHOW=5
TZ_OFFSET=+09:00
# 口コミ保存先（SQLite）
# REVIEW_DB_PATH=./data/reviews.db
